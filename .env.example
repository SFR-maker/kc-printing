# Database (Railway PostgreSQL)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require"

# Clerk Auth
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
CLERK_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/account
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/account

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# OpenRouter (server-side only, never expose to browser)
OPENROUTER_API_KEY=sk-or-...

# UploadThing
UPLOADTHING_TOKEN=...

# Resend Email
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=hello@kcprinting.com

# Admin
ADMIN_EMAIL=admin@kcprinting.com

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Template artwork (thumbnails, card art, product art, archetype textures) is served from
# Cloudflare R2, not from the repo - see the note in .gitignore. Required for local development:
# without it those images 404, because the files are not checked out.
NEXT_PUBLIC_ASSET_CDN_BASE=https://cdn.611printing.com

# Uploading new artwork to R2 (local/CI only - never set these in Vercel, the S3 SDK is a
# devDependency and must stay out of the deployed function):
#   node --env-file=.env.local scripts/upload-assets-to-r2.mjs
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
